---
import ScrollAnimation from "./ScrollAnimation.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<section
    class="relative min-h-[40vh] md:min-h-[50vh] flex flex-col md:flex-row border-b border-clay"
>
    <div
        class="flex-1 flex items-center justify-center md:justify-end md:pr-12 lg:pr-16 px-6 py-12 md:py-0 border-b md:border-b-0 md:border-r border-clay"
    >
        <div class="max-w-md w-full text-center md:text-right">
            <ScrollAnimation direction="up" delay="100">
                <h1 class="heading-display mb-2">
                    <Fragment set:html={title} />
                </h1>
            </ScrollAnimation>
        </div>
    </div>

    <div
        class="flex-1 flex items-center justify-center md:justify-start md:pl-12 lg:pl-16 px-6 py-12 md:py-0"
    >
        <div class="max-w-md w-full">
            {
                description && (
                    <ScrollAnimation direction="up" delay="200">
                        <p class="text-lg md:text-xl lg:text-2xl text-charcoal leading-relaxed font-light">
                            {description}
                        </p>
                    </ScrollAnimation>
                )
            }
        </div>
    </div>
</section>
