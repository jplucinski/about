---
import Layout from "../components/Layout.astro";
import StructuredData from "../components/StructuredData.astro";
import { getEntry } from "astro:content";

const aboutContent = (await getEntry("pages", "about").catch(
  () => null,
)) as any;
const siteSettings = (await getEntry("site", "settings").catch(
  () => null,
)) as any;

const professionalSummary =
  aboutContent?.data?.professionalSummary ||
  "Crafting digital solutions with passion and precision";
const bioRaw =
  aboutContent?.data?.bio ||
  `I'm a Senior Software Developer passionate about creating elegant solutions to complex problems. With expertise in modern web technologies, I focus on building scalable, maintainable applications that deliver exceptional user experiences.

My approach combines technical excellence with a deep understanding of user needs, ensuring that every project I work on is both technically sound and user-friendly.`;
const bio = bioRaw.split("\n").filter((p: string) => p.trim());
const frontendSkillsRaw =
  aboutContent?.data?.frontendSkills ||
  `React, Vue, Angular
TypeScript, JavaScript
Astro, Next.js
Tailwind CSS, CSS-in-JS`;
const frontendSkills = frontendSkillsRaw
  .split("\n")
  .filter((s: string) => s.trim());
const backendSkillsRaw =
  aboutContent?.data?.backendSkills ||
  `Node.js, Python
REST & GraphQL APIs
Database Design
Cloud Infrastructure`;
const backendSkills = backendSkillsRaw
  .split("\n")
  .filter((s: string) => s.trim());
const experience = aboutContent?.data?.experience || [];
const education = aboutContent?.data?.education || "";
const languages = aboutContent?.data?.languages || "";
const contactText =
  aboutContent?.data?.contactText ||
  "Interested in working together or have a question? Feel free to reach out.";
const email = siteSettings?.data?.email || "contact@jplucinski.dev";

const siteUrl = Astro.site?.href || "https://jplucinski.dev";
---

<Layout
  title="About"
  description="About Jędrzej Pluciński - Senior Software Developer"
>
  <StructuredData
    type="Person"
    data={{
      name: "Jędrzej Pluciński",
      jobTitle: siteSettings?.data?.tagline || "Senior Software Developer",
      description: siteSettings?.data?.description,
      url: siteUrl,
      email: email,
      sameAs: [
        siteSettings?.data?.social?.github,
        siteSettings?.data?.social?.linkedin,
        siteSettings?.data?.social?.twitter,
      ].filter(Boolean),
    }}
  />
  <div class="min-h-screen bg-white">
    <section
      class="relative min-h-[40vh] md:min-h-[50vh] flex flex-col md:flex-row"
    >
      <div
        class="flex-1 flex items-center justify-center md:justify-end md:pr-8 lg:pr-12 px-6 py-8 md:py-0 border-b md:border-b-0 md:border-r border-clay"
      >
        <div class="max-w-md">
          <h1 class="heading-display text-left mb-2">
            <span class="block">About</span>
            <span class="block">Me</span>
          </h1>
        </div>
      </div>

      <div
        class="flex-1 flex items-center justify-center md:justify-start md:pl-8 lg:pl-12 px-6 py-8 md:py-0"
      >
        <div class="max-w-md">
          <p
            class="text-lg md:text-xl lg:text-2xl text-charcoal leading-relaxed font-light"
          >
            {professionalSummary}
          </p>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-6 py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <div class="space-y-4 md:space-y-6">
          {
            bio.map((paragraph: string, index: number) => (
              <p class="text-base md:text-lg lg:text-xl text-charcoal leading-relaxed font-light">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="container mx-auto px-6 py-12 md:py-16 border-t border-clay"
    >
      <div class="max-w-6xl mx-auto">
        <h2 class="heading-2 mb-8 md:mb-10 text-center">Skills & Expertise</h2>

        <div class="grid md:grid-cols-2 gap-8 md:gap-10">
          <div>
            <h3
              class="text-lg md:text-xl font-display font-semibold mb-4 text-ink"
            >
              Frontend
            </h3>
            <ul class="space-y-2">
              {
                frontendSkills.map((skill: string, index: number) => (
                  <li class="text-sm md:text-base text-stone font-light border-b border-clay pb-2 last:border-0">
                    {skill}
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3
              class="text-lg md:text-xl font-display font-semibold mb-4 text-ink"
            >
              Backend
            </h3>
            <ul class="space-y-2">
              {
                backendSkills.map((skill: string, index: number) => (
                  <li class="text-sm md:text-base text-stone font-light border-b border-clay pb-2 last:border-0">
                    {skill}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {
      experience.length > 0 && (
        <section class="container mx-auto px-6 py-12 md:py-16 border-t border-clay">
          <div class="max-w-4xl mx-auto">
            <h2 class="heading-2 mb-8 md:mb-10 text-center">Experience</h2>

            <div class="space-y-6 md:space-y-8">
              {experience.map((exp: any, index: number) => (
                <div class="border-l-2 border-clay pl-6 md:pl-8">
                  <div class="mb-2">
                    <span class="text-xs md:text-sm text-stone font-light">
                      {exp.period}
                    </span>
                  </div>
                  <h3 class="text-lg md:text-xl font-display font-semibold mb-1 text-ink">
                    {exp.position}
                  </h3>
                  <p class="text-base md:text-lg text-charcoal mb-2 font-light">
                    {exp.company}
                    {exp.technologies && (
                      <span class="text-stone"> • {exp.technologies}</span>
                    )}
                  </p>
                  <ul class="space-y-1">
                    {exp.responsibilities.map(
                      (resp: string, respIndex: number) => (
                        <li class="text-sm md:text-base text-stone font-light flex items-start">
                          <span class="text-stone mr-2 mt-1">•</span>
                          <span>{resp}</span>
                        </li>
                      ),
                    )}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      (education || languages) && (
        <section class="container mx-auto px-6 py-12 md:py-16 border-t border-clay">
          <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-2 gap-8 md:gap-10">
              {education && (
                <div>
                  <h3 class="text-lg md:text-xl font-display font-semibold mb-4 text-ink">
                    Education
                  </h3>
                  <p class="text-sm md:text-base text-stone font-light leading-relaxed">
                    {education}
                  </p>
                </div>
              )}

              {languages && (
                <div>
                  <h3 class="text-lg md:text-xl font-display font-semibold mb-4 text-ink">
                    Languages
                  </h3>
                  <p class="text-sm md:text-base text-stone font-light leading-relaxed">
                    {languages}
                  </p>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <section
      class="container mx-auto px-6 py-12 md:py-16 border-t border-clay"
    >
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="heading-2 mb-2 text-ink">Get in Touch</h2>
        <p
          class="text-base md:text-lg text-stone mb-6 font-light leading-relaxed"
        >
          {contactText}
        </p>
        <div class="flex items-center justify-center gap-6">
          {
            siteSettings?.data?.social?.github && (
              <a
                href={siteSettings.data.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd"
                  />
                </svg>
                GitHub
              </a>
            )
          }
          {
            siteSettings?.data?.social?.linkedin && (
              <a
                href={siteSettings.data.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
              </a>
            )
          }
          {
            siteSettings?.data?.social?.twitter && (
              <a
                href={siteSettings.data.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M13.5445 10.7358L22.0011 1H20.0698L12.6317 9.41915L6.69481 1H0L8.89425 13.5969L0 23.8848H1.93135L9.80654 14.9632L16.0889 23.8848H22.7837L13.5445 10.7358ZM10.8088 13.7969L9.92446 12.5764L2.60044 2.45896H5.76132L11.7827 10.6839L12.667 11.9044L20.0698 22.5026H16.909L10.8088 13.7969Z"/>
                </svg>
                Medium
              </a>
            )
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
