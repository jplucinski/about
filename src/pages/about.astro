---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import StructuredData from "../components/StructuredData.astro";
import { getEntry } from "astro:content";

const aboutContent = (await getEntry("pages", "about").catch(
  () => null,
)) as any;
const siteSettings = (await getEntry("site", "settings").catch(
  () => null,
)) as any;

const professionalSummary =
  aboutContent?.data?.professionalSummary ||
  "Crafting digital solutions with passion and precision";
const bio = (aboutContent?.data?.bio || "")
  .split("\n")
  .filter((p: string) => p.trim());
const frontendSkillsRaw =
  aboutContent?.data?.frontendSkills ||
  `React, Vue, Angular
TypeScript, JavaScript
Astro, Next.js
Tailwind CSS, CSS-in-JS`;
const frontendSkills = frontendSkillsRaw
  .split("\n")
  .filter((s: string) => s.trim());
const backendSkillsRaw =
  aboutContent?.data?.backendSkills ||
  `Node.js, Python
REST & GraphQL APIs
Database Design
Cloud Infrastructure`;
const backendSkills = backendSkillsRaw
  .split("\n")
  .filter((s: string) => s.trim());
const experience = aboutContent?.data?.experience || [];
const education = aboutContent?.data?.education || "";
const languages = aboutContent?.data?.languages || "";
const contactText =
  aboutContent?.data?.contactText ||
  "Interested in working together or have a question? Feel free to reach out.";
const email = siteSettings?.data?.email || "contact@jplucinski.dev";

const siteUrl = Astro.site?.href || "https://jplucinski.dev";
const hasBio = bio.length > 0;

const summarizeList = (items: string[], count = 3) =>
  items.filter(Boolean).slice(0, count).join(", ");

const frontendHighlight = summarizeList(frontendSkills);
const backendHighlight = summarizeList(backendSkills);

const skillsSummary = backendSkills.length
  ? `My core expertise lies in ${backendHighlight || "Java ecosystem"}, supported by ${frontendHighlight || "modern frontend tech"} for full-stack delivery.`
  : null;

const currentRole = experience[0];
const previousCompanies = experience
  .slice(1)
  .map((exp: any) => exp.company)
  .filter(Boolean);

const experienceSummary = currentRole
  ? `Currently working as ${currentRole.position} at ${currentRole.company}, keeping ${currentRole.technologies || "our stack"} reliable${
      previousCompanies.length
        ? `, after teaming up with ${previousCompanies.join(", ")}`
        : ""
    }.`
  : null;

const educationSummary = education?.trim() ? education : null;
const languagesSummary = languages?.trim() ? languages : null;
const hasSnapshot =
  skillsSummary || experienceSummary || educationSummary || languagesSummary;
---

<Layout
  title="About"
  description="About Jędrzej Pluciński - Senior Software Developer"
>
  <StructuredData
    type="Person"
    data={{
      name: "Jędrzej Pluciński",
      jobTitle: siteSettings?.data?.tagline || "Senior Software Developer",
      description: siteSettings?.data?.description,
      url: siteUrl,
      email: email,
      sameAs: [
        siteSettings?.data?.social?.github,
        siteSettings?.data?.social?.linkedin,
        siteSettings?.data?.social?.twitter,
      ].filter(Boolean),
    }}
  />
  <div class="min-h-screen">
    <PageHero
      title={`<span class="block">About</span><span class="block text-terracotta">Me</span>`}
      description={professionalSummary}
    />

    {
      hasBio && (
        <section class="container mx-auto px-6 py-12 md:py-16">
          <div class="max-w-4xl mx-auto">
            <div class="space-y-4 md:space-y-6">
              {bio.map((paragraph: string) => (
                <p class="text-base md:text-lg lg:text-xl text-charcoal leading-relaxed font-light">
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      hasSnapshot && (
        <section class="container mx-auto px-6 py-12 md:py-16 border-t border-clay">
          <div class="max-w-5xl mx-auto">
            <h2 class="heading-2 mb-8 md:mb-12 text-center">Snapshot</h2>
            <div class="space-y-8">
              {skillsSummary && (
                <div class="flex flex-col md:flex-row gap-4 md:gap-8 border-b border-clay/30 pb-8 last:border-0">
                  <div class="md:w-32 flex-shrink-0">
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-terracotta">
                      Core Stack
                    </p>
                  </div>
                  <div class="flex-1">
                    <p class="text-base md:text-lg text-charcoal leading-relaxed font-light">
                      {skillsSummary}
                    </p>
                  </div>
                </div>
              )}
              {experienceSummary && (
                <div class="flex flex-col md:flex-row gap-4 md:gap-8 border-b border-clay/30 pb-8 last:border-0">
                  <div class="md:w-32 flex-shrink-0">
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-terracotta">
                      Experience
                    </p>
                  </div>
                  <div class="flex-1">
                    <p class="text-base md:text-lg text-charcoal leading-relaxed font-light">
                      {experienceSummary}
                    </p>
                  </div>
                </div>
              )}
              {educationSummary && (
                <div class="flex flex-col md:flex-row gap-4 md:gap-8 border-b border-clay/30 pb-8 last:border-0">
                  <div class="md:w-32 flex-shrink-0">
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-terracotta">
                      Education
                    </p>
                  </div>
                  <div class="flex-1">
                    <p class="text-base md:text-lg text-charcoal leading-relaxed font-light">
                      {educationSummary}
                    </p>
                  </div>
                </div>
              )}
              {languagesSummary && (
                <div class="flex flex-col md:flex-row gap-4 md:gap-8 border-b border-clay/30 pb-8 last:border-0">
                  <div class="md:w-32 flex-shrink-0">
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-terracotta">
                      Languages
                    </p>
                  </div>
                  <div class="flex-1">
                    <p class="text-base md:text-lg text-charcoal leading-relaxed font-light">
                      {languagesSummary}
                    </p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <section class="container mx-auto px-6 py-12 md:py-16 border-t border-clay">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="heading-2 mb-2 text-ink">Get in Touch</h2>
        <p
          class="text-base md:text-lg text-stone mb-6 font-light leading-relaxed"
        >
          {contactText}
        </p>
        <div class="flex items-center justify-center gap-6">
          {
            siteSettings?.data?.social?.github && (
              <a
                href={siteSettings.data.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd"
                  />
                </svg>
                GitHub
              </a>
            )
          }
          {
            siteSettings?.data?.social?.linkedin && (
              <a
                href={siteSettings.data.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
              </a>
            )
          }
          {
            siteSettings?.data?.social?.twitter && (
              <a
                href={siteSettings.data.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-base md:text-lg text-ink font-light border-b-2 border-ink pb-1 hover:border-terracotta hover:text-terracotta transition-colors"
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M13.5445 10.7358L22.0011 1H20.0698L12.6317 9.41915L6.69481 1H0L8.89425 13.5969L0 23.8848H1.93135L9.80654 14.9632L16.0889 23.8848H22.7837L13.5445 10.7358ZM10.8088 13.7969L9.92446 12.5764L2.60044 2.45896H5.76132L11.7827 10.6839L12.667 11.9044L20.0698 22.5026H16.909L10.8088 13.7969Z" />
                </svg>
                Medium
              </a>
            )
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
