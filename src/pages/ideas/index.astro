---
import Layout from "../../components/Layout.astro";
import IdeaCard from "../../components/IdeaCard.astro";
import { getCollection } from "astro:content";

const ideas = (await getCollection("ideas")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Layout title="Ideas" description="Ideas and thoughts by Jędrzej Pluciński">
  <div class="min-h-screen bg-white">
    <section
      class="relative min-h-[30vh] md:min-h-[35vh] flex flex-col md:flex-row"
    >
      <div
        class="flex-1 flex items-center justify-center md:justify-end md:pr-8 lg:pr-12 px-6 py-8 md:py-0 border-b md:border-b-0 md:border-r border-clay"
      >
        <div class="max-w-md">
          <h1 class="heading-display text-left mb-2">
            <span class="block">Ideas</span>
          </h1>
        </div>
      </div>

      <div
        class="flex-1 flex items-center justify-center md:justify-start md:pl-8 lg:pl-12 px-6 py-8 md:py-0"
      >
        <div class="max-w-md">
          <p
            class="text-lg md:text-xl lg:text-2xl text-charcoal leading-relaxed font-light"
          >
            Thoughts, insights, and updates on software development, technology,
            and more.
          </p>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-6 py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        {
          ideas.length > 0 ? (
            <div class="space-y-6 md:space-y-8">
              {ideas.map((idea, index) => (
                <IdeaCard
                  title={idea.data.title}
                  description={idea.data.description}
                  pubDate={idea.data.pubDate}
                  slug={idea.slug}
                  tags={idea.data.tags}
                  category={idea.data.category}
                  featuredImage={idea.data.featuredImage}
                />
              ))}
            </div>
          ) : (
            <div class="text-center py-16">
              <h2 class="heading-2 mb-2 text-ink">No ideas yet</h2>
              <p class="text-sm text-stone max-w-md mx-auto font-light">
                Check back soon for updates and new content!
              </p>
            </div>
          )
        }
      </div>
    </section>
  </div>
</Layout>
