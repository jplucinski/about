---
import Layout from '../../components/Layout.astro';
import ScrollAnimation from '../../components/ScrollAnimation.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  return ideas.map((idea) => ({
    params: { slug: idea.slug },
    props: { idea },
  }));
}

interface Props {
  idea: CollectionEntry<'ideas'>;
}

const { idea } = Astro.props;
const { Content } = await idea.render();
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(idea.data.pubDate);

const siteUrl = Astro.site?.href || 'https://jplucinski.dev';
const ideaUrl = `${siteUrl}/ideas/${idea.slug}`;
---

<Layout 
  title={idea.data.title} 
  description={idea.data.description}
  type="article"
  url={ideaUrl}
>
  <StructuredData 
    type="BlogPosting" 
    data={{
      headline: idea.data.title,
      description: idea.data.description,
      datePublished: idea.data.pubDate.toISOString(),
      dateModified: idea.data.pubDate.toISOString(),
      author: idea.data.author,
      url: ideaUrl,
    }} 
  />
  <article class="min-h-screen bg-white">
    <section class="container mx-auto px-6 py-16 md:py-24 border-b border-clay">
      <div class="max-w-4xl mx-auto">
        <ScrollAnimation direction="up" delay="0">
          <a href="/ideas" class="inline-flex items-center gap-2 text-sm text-stone hover:text-ink transition-colors mb-12 font-light">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Ideas
          </a>
        </ScrollAnimation>
        <ScrollAnimation direction="up" delay="100">
          <header>
            <h1 class="heading-display mb-8">{idea.data.title}</h1>
            <p class="text-xl md:text-2xl text-charcoal mb-6 font-light leading-relaxed">{idea.data.description}</p>
          </header>
        </ScrollAnimation>
      </div>
    </section>

    <section class="container mx-auto px-6 py-16 md:py-24">
      <div class="max-w-3xl mx-auto">
        <div class="prose max-w-none">
          <Content />
        </div>
      </div>
    </section>
  </article>
</Layout>

<style is:global>
  .prose {
    font-family: 'Inter', sans-serif;
    color: #333333;
  }
  
  .prose h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.875rem;
    font-weight: 700;
    color: #191919;
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .prose h2:first-child {
    margin-top: 0;
  }
  
  .prose h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #191919;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  
  .prose p {
    font-size: 1.25rem;
    line-height: 1.8;
    color: #333333;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }
  
  .prose ul {
    margin-bottom: 1.5rem;
    list-style: none;
    padding-left: 0;
  }
  
  .prose ul li {
    font-size: 1.25rem;
    line-height: 1.8;
    color: #333333;
    font-weight: 300;
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }
  
  .prose ul li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #d0684f;
    font-weight: 400;
  }
  
  .prose strong {
    color: #191919;
    font-weight: 600;
  }
  
  .prose a {
    color: #191919;
    text-decoration: underline;
    text-decoration-color: #e6e4dd;
    transition: all 0.2s;
  }
  
  .prose a:hover {
    color: #d0684f;
    text-decoration-color: #d0684f;
  }
  
  .prose em {
    font-style: italic;
  }
  
  .prose blockquote {
    border-left: 4px solid #d0684f;
    padding-left: 1.5rem;
    font-style: italic;
    color: #666666;
    margin: 2rem 0;
  }
  
  .prose code {
    background-color: #f4f3ef;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: 'JetBrains Mono', monospace;
    color: #191919;
  }
  
  .prose pre {
    background-color: #191919;
    color: #f4f3ef;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: #f4f3ef;
  }
  
  @media (min-width: 768px) {
    .prose h2 {
      font-size: 2.25rem;
    }
    
    .prose h3 {
      font-size: 1.875rem;
    }
  }
</style>

