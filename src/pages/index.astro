---
import Layout from "../components/Layout.astro";
import IdeaCard from "../components/IdeaCard.astro";
import ScrollAnimation from "../components/ScrollAnimation.astro";
import StructuredData from "../components/StructuredData.astro";
import { getCollection, getEntry } from "astro:content";

const ideas = (await getCollection("ideas")).slice(0, 3);

const homeContent = await getEntry("pages", "home").catch(() => null);
const siteSettings = await getEntry("site", "settings").catch(() => null);

const homeData: any = homeContent?.data ?? {};
const siteData: any = siteSettings?.data ?? {};

const heroTitle = homeData.heroTitle || "Jędrzej Pluciński";
const heroSubtitle =
  homeData.heroSubtitle ||
  "Crafting digital experiences with code & creativity";
const heroDescription =
  homeData.heroDescription ||
  "Building modern web applications with passion for clean code, innovative solutions, and exceptional user experiences.";
const tagline = siteData.tagline || "Senior Software Developer";
const ctaPrimary = homeData.ctaPrimary || "Learn More";
const ctaSecondary = homeData.ctaSecondary || "View Ideas";
const ctaPrimaryLink = homeData.ctaPrimaryLink || "/about";
const ctaSecondaryLink = homeData.ctaSecondaryLink || "/ideas";
const featuredTitle = homeData.featuredTitle || "Latest Ideas";
const featuredSubtitle = homeData.featuredSubtitle || "Latest Thoughts";
const featuredDescription =
  homeData.featuredDescription ||
  "Insights, tutorials, and reflections on software development";

const siteUrl = Astro.site?.href || "https://jplucinski.dev";
const pageDescription = siteData.description || "Senior Software Developer";
const social = siteData.social || {};
---

<Layout title="Home" description={pageDescription}>
  <StructuredData
    type="WebSite"
    data={{
      name: siteData.name || "jplucinski.dev",
      description: pageDescription,
    }}
  />
  <div class="min-h-screen">
    <section class="max-w-[90rem] mx-auto px-6 pt-20 pb-32 md:pt-32 md:pb-40">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center"
      >
        {/* Left Content Area - Asymmetric Larger Side */}
        <div
          class="lg:col-span-7 order-2 lg:order-1 flex flex-col items-start gap-8 md:gap-10"
        >
          <ScrollAnimation direction="up" delay="100">
            {/* Using 'terracotta' which is now mapped to Primary Blue */}
            <h1
              class="font-display font-medium text-5xl md:text-7xl lg:text-8xl leading-[1.1] tracking-tight text-ink"
            >
              <span class="block text-terracotta">Senior</span>
              <span class="block">Software</span>
              <span class="block text-stone">Developer.</span>
            </h1>
          </ScrollAnimation>

          <ScrollAnimation direction="up" delay="300">
            <h2
              class="text-xl md:text-2xl text-stone font-light max-w-2xl leading-relaxed"
            >
              {heroSubtitle}
            </h2>
            <p
              class="mt-6 text-lg text-stone/80 font-light max-w-xl leading-relaxed"
            >
              {heroDescription}
            </p>
          </ScrollAnimation>

          <ScrollAnimation direction="up" delay="400">
            <div class="flex flex-wrap gap-4 mt-2">
              <a
                href={ctaPrimaryLink}
                class="px-8 py-4 bg-terracotta text-white text-sm font-semibold uppercase tracking-widest rounded-full hover:bg-ink transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1"
              >
                {ctaPrimary}
              </a>
              <a
                href={ctaSecondaryLink}
                class="px-8 py-4 bg-transparent border border-ink text-ink text-sm font-semibold uppercase tracking-widest rounded-full hover:bg-ink hover:text-white transition-all duration-300"
              >
                {ctaSecondary}
              </a>
            </div>
          </ScrollAnimation>
        </div>

        {/* Right Visual Area - Creative Image */}
        <div class="lg:col-span-5 order-1 lg:order-2 relative">
          <ScrollAnimation direction="scale" delay="200">
            <div class="relative z-10">
              {/* Premium Circle Design */}
              <div
                class="relative w-full aspect-square max-w-[450px] mx-auto rounded-full overflow-hidden shadow-2xl ring-4 ring-white/60 animate-float"
              >
                <img
                  src="/images/profile.png"
                  alt="Jędrzej Pluciński"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out"
                />
              </div>

              {/* Decorative elements - Centered Blob */}
              <div
                class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-gradient-radial from-terracotta/20 to-transparent opacity-60 blur-3xl rounded-full animate-pulse-slow"
              >
              </div>
            </div>
          </ScrollAnimation>
        </div>
      </div>
    </section>

    {
      ideas.length > 0 && (
        <section class="container mx-auto px-6 py-12 md:py-16">
          <div class="max-w-4xl mx-auto">
            <div class="mb-8 md:mb-12 text-center">
              <h2 class="heading-2 mb-3 text-ink">{featuredTitle}</h2>
              <p class="text-base md:text-lg text-stone max-w-2xl mx-auto font-light leading-relaxed">
                {featuredDescription}
              </p>
            </div>
            <div class="space-y-6 md:space-y-8">
              {ideas.map((idea, index) => (
                <IdeaCard
                  title={idea.data.title}
                  description={idea.data.description}
                  pubDate={idea.data.pubDate}
                  slug={idea.slug}
                />
              ))}
            </div>
            <div class="text-center mt-8">
              <a
                href="/ideas"
                class="inline-block text-base md:text-lg text-ink font-serif border-b border-ink pb-1 hover:text-terracotta hover:border-terracotta transition-colors"
              >
                View all ideas
              </a>
            </div>
          </div>
        </section>
      )
    }
  </div>
</Layout>
